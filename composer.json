{
    "name": "plutuss/query-filter-laravel",
    "description": "Laravel Eloquent query filtering with request validation, filter allowlists, array filters, relationship queries, and Livewire support.",
    "keywords": [
        "php",
        "laravel",
        "eloquent",
        "laravel-package",
        "query-filter",
        "query-filter-laravel",
        "eloquent-filter",
        "laravel-filter",
        "query-builder",
        "request-filtering",
        "database-filtering",
        "validation",
        "livewire"
    ],
    "minimum-stability": "stable",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "plutuss",
            "email": "dima92konovalenko@gmail.com",
            "homepage": "https://github.com/plutuss"
        }
    ],
    "require": {
        "php": "^8.0"
    },
    "autoload": {
        "psr-4": {
            "Plutuss\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Plutuss\\Providers\\QueryFilterServiceProvider"
            ]
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "laravel/framework": "^9.0|^10.0|^11.0|^12.0|^13.0"
    },
    "scripts": {
        "test": "phpunit"
    },
    "autoload-dev": {
        "psr-4": {
            "Plutuss\\Tests\\": "tests/"
        }
    },
    "homepage": "https://github.com/plutuss/query-filter-laravel",
    "support": {
        "issues": "https://github.com/plutuss/query-filter-laravel/issues",
        "source": "https://github.com/plutuss/query-filter-laravel",
        "docs": "https://github.com/plutuss/query-filter-laravel/blob/main/README.md"
    }
}
