{
    "name": "plutuss/query-filter-laravel",
    "description": "Query Filter Laravel package.",
    "keywords": [
        "laravel",
        "filter",
        "query"
    ],
    "minimum-stability": "stable",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "plutuss",
            "email": "dima92konovalenko@gmail.com",
            "homepage": "https://github.com/plutuss"
        }
    ],
    "require": {
        "php": "^8.0|^8.1|^8.2|^8.3"
    },
    "autoload": {
        "psr-4": {
            "Plutuss\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Plutuss\\Providers\\QueryFilterServiceProvider"
            ]
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "laravel/framework": "^9.0|^10.0|^11.0|^12.0"
    },
    "scripts": {
        "test": "phpunit"
    },
    "autoload-dev": {
        "psr-4": {
            "Plutuss\\Tests\\": "tests/"
        }
    }
}
